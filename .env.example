# Copiez ce fichier en .env.local pour le développement local,
# et ajoutez les mêmes variables dans Vercel > Settings > Environment Variables.

# --- Supabase (base de données gratuite) ---
# À récupérer dans Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Espace admin ---
# Mot de passe pour accéder à /admin (choisissez-en un solide)
ADMIN_PASSWORD=
